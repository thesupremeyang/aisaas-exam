[Unit]
Description=Apboa Shell Proxy (命令执行代理 :3062)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=apboa
Group=apboa
WorkingDirectory=/wwwroot
EnvironmentFile=/wwwroot/apboa.env
Environment=SPRING_PROFILES_ACTIVE=docker
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /wwwroot/jars/runner-proxy-1.0-SNAPSHOT.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# ============================================================
# Apboa 生产环境变量模板
# 复制为 apboa.env 并修改所有 CHANGE_ME 为强口令：
#   cp apboa.env.example apboa.env && vim apboa.env
# 由 systemd 的 EnvironmentFile 加载（KEY=VALUE，无 export、等号两侧无空格）
# ============================================================

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_strong
REDIS_DATABASE=7

# ---- MySQL（主业务库，对应 sql/once_db_init/db_init.sql）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=apboa_next
MYSQL_USER=apboa
MYSQL_PASSWORD=CHANGE_ME_mysql_strong

# ---- PostgreSQL / pgvector（向量库，runtime 使用）----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=apboa_vector
PG_USER=apboa
PG_PASSWORD=CHANGE_ME_pg_strong
VECTOR_STORE_TYPE=pgvector

# ---- JWT（console / runtime / websocket 必须完全一致）----
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret_at_least_32_chars

# ---- 跨服务地址（同机部署填 127.0.0.1）----
CONSOLE_HOST=127.0.0.1
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_ENABLED=true
PROXY_HOST=127.0.0.1
SHELL_PROXY_ENABLED=true

# ---- shell-proxy 执行限制 ----
SHELL_DEFAULT_TIMEOUT=300
SHELL_MAX_TIMEOUT=3600
SHELL_MAX_OUTPUT_SIZE=52428800

# ---- 考试 AI 初评（必须由服务器注入，不要写入代码或 JAR）----
ASSESSMENT_ARK_API_KEY=CHANGE_ME_ark_api_key
ASSESSMENT_ARK_MODEL=deepseek-v4-flash
